<?xml version="1.0"?>
<robot name="Xcar">
  <!-- ========== 地面投影（不动） ========== -->
  <link name="base_footprint" />

  <!-- ========== 底盘（长方体车身） ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.30 0.18 0.06" />
      </geometry>
      <material name="body_color">
        <color rgba="0.2 0.4 0.8 1.0" />
      </material>
    </visual>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0" />
  </joint>

  <!-- ========== 车头标记（红色，区分前后） ========== -->
  <link name="front_marker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.06 0.02" />
      </geometry>
      <material name="front_color">
        <color rgba="1.0 0.1 0.1 1.0" />
      </material>
    </visual>
  </link>
  <joint name="front_marker_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_marker" />
    <origin xyz="0.15 0 0.02" rpy="0 0 0" />
  </joint>

  <!-- ========== 左前轮 ========== -->
  <link name="left_front_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder length="0.02" radius="0.03" />
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
  </link>
  <joint name="left_front_wheel_joint" type="fixed">
    <parent link="base_link" />
    <child link="left_front_wheel" />
    <origin xyz="0.10 0.12 -0.02" rpy="0 0 0" />
  </joint>

  <!-- ========== 右前轮 ========== -->
  <link name="right_front_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder length="0.02" radius="0.03" />
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
  </link>
  <joint name="right_front_wheel_joint" type="fixed">
    <parent link="base_link" />
    <child link="right_front_wheel" />
    <origin xyz="0.10 -0.12 -0.02" rpy="0 0 0" />
  </joint>

  <!-- ========== 左后轮 ========== -->
  <link name="left_rear_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder length="0.02" radius="0.03" />
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
  </link>
  <joint name="left_rear_wheel_joint" type="fixed">
    <parent link="base_link" />
    <child link="left_rear_wheel" />
    <origin xyz="-0.10 0.12 -0.02" rpy="0 0 0" />
  </joint>

  <!-- ========== 右后轮 ========== -->
  <link name="right_rear_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder length="0.02" radius="0.03" />
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
  </link>
  <joint name="right_rear_wheel_joint" type="fixed">
    <parent link="base_link" />
    <child link="right_rear_wheel" />
    <origin xyz="-0.10 -0.12 -0.02" rpy="0 0 0" />
  </joint>

  <!-- ========== 激光雷达（保持原有 TF 不变） ========== -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.02" radius="0.02" />
      </geometry>
      <material name="laser_color">
        <color rgba="0.0 0.0 0.0 0.5" />
      </material>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_link" />
    <origin xyz="0 0 0.075" rpy="0 0 -1.5708" />
  </joint>

  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.02" radius="0.02" />
      </geometry>
      <material name="laser_color">
        <color rgba="0.0 0.0 0.0 0.5" />
      </material>
    </visual>
  </link>
  <joint name="laser_frame_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_frame" />
    <origin xyz="0 0 0.075" rpy="0 0 2.0943" />
  </joint>
</robot>
